# Example environment variables for the Time Tracking Frontend

# Base URL for the backend API consumed by the React app
# Update this to match your deployment target if different.
REACT_APP_API_BASE_URL=https://b13b6b58.api.kavia.app/

# Note:
# Other environment variables may be supported by your deployment tooling:
# REACT_APP_API_BASE, REACT_APP_BACKEND_URL, REACT_APP_FRONTEND_URL, REACT_APP_WS_URL,
# REACT_APP_NODE_ENV, REACT_APP_NEXT_TELEMETRY_DISABLED, REACT_APP_ENABLE_SOURCE_MAPS,
# REACT_APP_PORT, REACT_APP_TRUST_PROXY, REACT_APP_LOG_LEVEL, REACT_APP_HEALTHCHECK_PATH,
# REACT_APP_FEATURE_FLAGS, REACT_APP_EXPERIMENTS_ENABLED
# These are optional here; this app primarily uses REACT_APP_API_BASE_URL.
